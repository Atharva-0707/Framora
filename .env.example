# ==========================================
# Framora - Environment Variables Template
# ==========================================

# Backend Configuration (backend/.env)
PORT=5050
NODE_ENV=development

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/framora?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d

# Cloudinary Media Storage (For photography uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway (Key ID + Key Secret only)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Frontend Configuration (frontend/.env)
# VITE_API_URL=https://your-api-domain.com/api
