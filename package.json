{
  "name": "framora",
  "version": "1.0.0",
  "description": "Framora - Full Stack Photography Community Platform (MERN + Cloudinary)",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix backend run dev",
    "client": "npm --prefix frontend run dev",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test"
  },
  "keywords": [
    "mern",
    "photography",
    "framora",
    "cloudinary",
    "react",
    "node",
    "express",
    "mongodb"
  ],
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
