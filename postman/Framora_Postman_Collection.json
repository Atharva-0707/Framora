            "body": {
              "mode": "raw",
              "raw": "{\n  \"saleStatus\": \"FOR_SALE\",\n  \"price\": 1499,\n  \"currency\": \"INR\",\n  \"licenseInfo\": \"1-of-1 Original High-Resolution Master License.\"\n}"
