  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"test_photographer\",\n  \"name\": \"Test Photographer\",\n  \"email\": \"test@framora.art\",\n  \"password\": \"password123\",\n  \"location\": \"Tokyo, Japan\",\n  \"bio\": \"Street and documentary shooter.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"elena@framora.art\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Get All Posts (Feed / Search / Filter)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/posts?page=1&limit=12&filter=latest",
              "host": ["{{baseUrl}}"],
              "path": ["posts"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "12" },
                { "key": "filter", "value": "latest" },
                { "key": "tag", "value": "landscape", "disabled": true },
                { "key": "search", "value": "Patagonia", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Single Post by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "{{postId}}"]
            }
          }
        },
        {
          "name": "Create Post (Multipart / URL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Dusk over Alpine Lakes", "type": "text" },
                { "key": "caption", "value": "Shot right after sunset with 30s long exposure.", "type": "text" },
                { "key": "location", "value": "Swiss Alps", "type": "text" },
                { "key": "camera", "value": "Sony Alpha A7 IV", "type": "text" },
                { "key": "lens", "value": "FE 24-70mm F2.8 GM", "type": "text" },
                { "key": "focalLength", "value": "35mm", "type": "text" },
                { "key": "aperture", "value": "f/8.0", "type": "text" },
